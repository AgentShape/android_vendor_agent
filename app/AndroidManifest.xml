<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="moe.uni.agent">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- agent 的数据在用户存储中（ADR-0029）：所有文件访问，平台签名安装时即授予。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- 绑定 AgentFramework 的 IAgentScreen（ADR-0022）。 -->
    <uses-permission android:name="moe.uni.agent.framework.permission.SCREEN" />
    <!-- 绑定 AgentFramework 的 IAgentDevice（ADR-0029 第 6 条）。 -->
    <uses-permission android:name="moe.uni.agent.framework.permission.DEVICE" />
    <!-- 观察窗的气泡（ADR-0031 第 6 条）：运行时权限，第一次发送消息时请求。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 助手会话在锁屏时请求解锁（ADR-0033 第 7 条）：signature 权限，平台签名即授予。 -->
    <uses-permission android:name="android.permission.CONTROL_KEYGUARD" />
    <queries>
        <package android:name="moe.uni.agent.framework" />
    </queries>
    <!-- persistent：常驻进程，由 AgentService 持有 agentd 连接和 agent loop（ADR-0020）。 -->
    <application android:persistent="true" android:allowBackup="false" android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false" android:networkSecurityConfig="@xml/network_security_config"
        android:label="@string/app_name" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity android:name=".ui.MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".service.AgentService" android:exported="false" />
        <!-- 观察窗（ADR-0031 第 2 条）：气泡展开的镜像。气泡要求可调整大小；每次一个新文档、不进最近任务、单独的任务。 -->
        <activity android:name=".ui.MirrorActivity" android:exported="false" android:resizeableActivity="true"
            android:documentLaunchMode="always" android:excludeFromRecents="true"
            android:taskAffinity="moe.uni.agent.watch" />
        <!-- 观察窗通知的 deleteIntent（用户划掉气泡）。 -->
        <receiver android:name=".watch.WatchReceiver" android:exported="false" />
        <!-- 系统助手（ADR-0033 第 1 条）：持有 ASSISTANT 角色后由系统绑定，会话服务和 AgentService 在同一个常驻进程里。 -->
        <service android:name=".assist.AgentInteractionService" android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data android:name="android.voice_interaction" android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service android:name=".assist.AgentSessionService" android:exported="false"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <!-- 角色资格要求的语音识别服务，v1 是占位（第 8 条）。 -->
        <service android:name=".assist.AgentRecognitionService" android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
