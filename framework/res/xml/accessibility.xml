<?xml version="1.0" encoding="utf-8"?>
<!-- 读节点树和执行节点 action（ADR-0022 第 8 条）；事件用于判断 UI 是否稳定，并产生等待用的事件（ADR-0034 第 4 条：
     announcement，以及 notificationStateChanged 中的 toast）。 -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged|typeViewScrolled|typeAnnouncement|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagIncludeNotImportantViews|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="50" />
